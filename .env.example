# ==============================================================================
# EXAMSHIELD - CONFIGURATION & ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================
# Copy this file to '.env' for local development or enter these variables in your
# Render dashboard (Settings -> Environment) for online deployment.
# NEVER commit your real '.env' file containing secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & PUBLIC ACCESSIBILITY
# ------------------------------------------------------------------------------
# FLASK_ENV: Set to 'production' on Render/cloud, or 'development' locally.
FLASK_ENV=production

# FLASK_DEBUG: Set to 'False' in production for security.
FLASK_DEBUG=False

# SECRET_KEY: A cryptographically strong random string used to encrypt sessions.
# Generate a secure key in Python using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_hex_string_in_production

# BASE_URL: The public HTTPS domain of your deployed ExamShield instance.
# Example: https://examshield.onrender.com or https://examshield.yourdomain.com
# On Render, RENDER_EXTERNAL_URL is automatically detected, but setting BASE_URL
# ensures all QR codes and verification links always point to your canonical domain.
BASE_URL=https://examshield.onrender.com

# PORT: Server listening port (Render sets this automatically, default 5000)
PORT=5000

# ALLOWED_HOSTS: Comma-separated list of allowed hostnames (prevents Host header attacks)
# Example: examshield.onrender.com,localhost,127.0.0.1
ALLOWED_HOSTS=examshield.onrender.com,localhost,127.0.0.1

# ------------------------------------------------------------------------------
# 2. PERSISTENT CLOUD MYSQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# ExamShield requires a persistent MySQL database so user accounts, exams,
# audit logs, and blockchain records persist permanently across redeployments.
#
# Free cloud MySQL providers compatible with ExamShield:
# - TiDB Cloud Serverless (Recommended, free 25GB, 100% MySQL compatible)
# - Aiven for MySQL (Free tier)
# - Railway MySQL
# - Local XAMPP/MySQL (for local testing)
#
# OPTION A: Single Connection URL (Standard in cloud platforms)
# DATABASE_URL=mysql://username:password@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/examshield?ssl-mode=REQUIRED
#
# OPTION B: Discrete Connection Parameters
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=examshield

# DB_SSL_DISABLED: Set to 'false' for cloud databases (TiDB, Aiven) that require SSL.
# For local XAMPP/MySQL, set to 'true'.
DB_SSL_DISABLED=true

# ------------------------------------------------------------------------------
# 3. SMTP TWO-FACTOR AUTHENTICATION (2FA) & EMAIL NOTIFICATIONS
# ------------------------------------------------------------------------------
# Used to deliver 6-digit OTP verification codes to officers during login
# and password reset. For Gmail, use an App Password (not your account password).
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_google_app_password

# ------------------------------------------------------------------------------
# 4. GEMINI AI QUESTION PAPER VALIDATION & SECURITY ENGINE
# ------------------------------------------------------------------------------
# Optional: Used for AI-powered question paper analysis, duplicate question
# detection, and leak risk scoring. If omitted or quota exceeded, ExamShield
# automatically falls back to its built-in heuristic security sweep engine.
GEMINI_API_KEY=your_gemini_api_key_here
